{
  "name": "shared-email-api",
  "version": "1.0.0",
  "description": "Shared email API worker powered by AWS SES",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:demo": "wrangler deploy --env demo",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "secrets:setup": "bash scripts/setup-secrets.sh",
    "secrets:list": "wrangler secret list",
    "kv:create": "wrangler kv namespace create RATE_LIMIT_KV",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "itty-router": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240129.0",
    "@types/node": "^20.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "wrangler": "^4.94.0"
  }
}