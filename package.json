{
  "name": "shared-email-api",
  "version": "1.0.0",
  "description": "Shared email API worker powered by AWS SES",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:development": "wrangler dev --env development",
    "dev:staging": "wrangler dev --env staging",
    "dev:production": "wrangler dev --env production",
    "deploy:development": "wrangler deploy --env development",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "tail:development": "wrangler tail --env development",
    "tail:staging": "wrangler tail --env staging",
    "tail:production": "wrangler tail --env production",
    "secrets:setup": "bash scripts/setup-secrets.sh",
    "secrets:list:development": "wrangler secret list --env development",
    "secrets:list:staging": "wrangler secret list --env staging",
    "secrets:list:production": "wrangler secret list --env production",
    "kv:create:staging": "wrangler kv namespace create RATE_LIMIT_KV --env staging",
    "kv:create:production": "wrangler kv namespace create RATE_LIMIT_KV --env production",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "itty-router": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240129.0",
    "@types/node": "^20.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "wrangler": "^4.36.0"
  }
}
